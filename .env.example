# Get this from @BotFather on Telegram after creating a bot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenGoesHere

# Your personal chat ID (see README: "Getting your chat ID")
TELEGRAM_CHAT_ID=123456789

# Get this by signing up at https://www.birjob.com/developers/keys
BIRJOB_API_KEY=bj_live_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# How often to check for new vacancies, in minutes
POLL_INTERVAL_MINUTES=60

# How many pages of recent jobs to scan per check (100 jobs/page)
MAX_PAGES=3

# BirJob recency filter: "24h" or "7d"
POSTED_WITHIN=24h
